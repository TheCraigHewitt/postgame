{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "postgame",
  "version": "0.1.0",
  "identifier": "dev.postgame.spike",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "postgame", "width": 960, "height": 640 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.4" }
  }
}
